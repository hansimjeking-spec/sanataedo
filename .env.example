# Google Drive OAuth (do not commit real values)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://gagyedo-ecomap.vercel.app/api/google-auth?action=callback
GOOGLE_SESSION_SECRET=replace-with-a-long-random-secret
